{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/glasnost-spec-dirty/**)",
      "Edit(~/glasnost-spec-dirty/**)",
      "Read(~/ra2-yr-setup/**)",
      "Edit(~/ra2-yr-setup/**)",
