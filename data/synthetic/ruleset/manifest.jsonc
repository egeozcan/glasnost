// SPDX-License-Identifier: CC0-1.0
// glasnost-synthetic: invented test data. Every name and number in this
// directory was made up for Glasnost's tests; none comes from any game's files.
//
// Synthetic ruleset. It exercises the shape of our rules format (PLAN.md 4.6):
// objects keyed by instance name, `inherits` lists, `^abstract` templates, set
// operations, integer numbers in native units and quoted decimals with a unit.
// The rules crate resolves and type-checks it against schema 1
// (crates/deterministic/rules/tests/synthetic_ruleset.rs).
{
  "schema": 1,
  "name": "glasnost-synthetic",
  // Layers in application order; later layers patch earlier ones.
  "layers": ["globals.jsonc", "combat.jsonc", "objects.jsonc"],
}
